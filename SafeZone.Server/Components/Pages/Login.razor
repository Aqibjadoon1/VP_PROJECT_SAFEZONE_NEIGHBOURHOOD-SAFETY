@page "/login"
@layout LoginLayout
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IWebHostEnvironment Environment

<div class="login-page">
    <div class="login-terminal">
        <div class="login-terminal-header">Secure Access Terminal</div>

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="login-alert login-alert-error">
                &#9888; @Uri.UnescapeDataString(error.Replace('+', ' '))
            </div>
        }

        @if (!string.IsNullOrEmpty(expired))
        {
            <div class="login-alert login-alert-warning">
                &#9888; Your session has expired. Please log in again.
            </div>
        }

        @if (!string.IsNullOrEmpty(loggedOut))
        {
            <div class="login-alert login-alert-info">
                &#8505; You have been signed out safely.
            </div>
        }

        <form action="/blazor-login" method="post" class="space-y-6">
            <AntiforgeryToken />
            <div>
                <label class="login-label">Phone or Email</label>
                <input type="text" name="Identifier" class="login-input" placeholder="+923001234567 or you@email.com" autocomplete="username" required />
            </div>

            <div>
                <label class="login-label">Password</label>
                <input type="password" name="Password" class="login-input" placeholder="&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;&#8226;" autocomplete="current-password" required minlength="8" />
            </div>

            <button type="submit" class="login-btn">
                <span>AUTHENTICATE</span>
            </button>
        </form>

        <div style="text-align: center; margin-top: 24px;">
            <a href="/register" style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3); text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em;">
                Initialize Account &rarr;
            </a>
        </div>
    </div>

    <p style="text-align: center; margin-top: 24px; font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.1em;">
        SafeZone v1.0 &bull; CS-284L &bull; Air University
    </p>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? error { get; set; }
    [SupplyParameterFromQuery] public string? expired { get; set; }
    [SupplyParameterFromQuery] public string? loggedOut { get; set; }
}
