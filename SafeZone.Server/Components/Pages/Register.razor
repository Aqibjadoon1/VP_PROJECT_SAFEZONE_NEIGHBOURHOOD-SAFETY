@page "/register"
@layout LoginLayout
@inject NavigationManager Navigation
@inject ToastService ToastSvc
@inject IAuthService AuthService
@inject ILogger<Register> Logger

<div class="login-page">
    <div class="login-terminal">
        <div class="login-terminal-header">Initialize Account</div>

        <EditForm Model="@model" OnValidSubmit="@HandleRegister" OnInvalidSubmit="@HandleInvalidSubmit" class="space-y-5">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div>
                <label class="login-label">Full Name</label>
                <InputText class="login-input" @bind-Value="model.FullName" placeholder="John Doe" autocomplete="name" />
                <ValidationMessage For="@(() => model.FullName)" />
            </div>

            <div>
                <label class="login-label">Email (for notifications)</label>
                <InputText class="login-input" @bind-Value="model.Email" placeholder="you@example.com" autocomplete="email" />
                <ValidationMessage For="@(() => model.Email)" />
            </div>

            <div>
                <label class="login-label">Phone Number</label>
                <InputText class="login-input" @bind-Value="model.PhoneNumber" placeholder="+923001234567" autocomplete="tel" />
                <ValidationMessage For="@(() => model.PhoneNumber)" />
            </div>

            <div>
                <label class="login-label">Account Type</label>
                <div style="display: flex; gap: 12px; margin-top: 8px;">
                    <div style="flex: 1; cursor: pointer;" @onclick="() => SelectRole(UserRole.Resident)">
                        <div style="padding: 16px; text-align: center; border-radius: var(--radius-md); border: 1px solid var(--glass-border); transition: all 200ms ease; @GetRoleCardStyle(UserRole.Resident)">
                            <div style="font-size: 1.5rem; margin-bottom: 8px;">🏠</div>
                            <div style="font-weight: 600; font-size: 0.9rem;">Resident</div>
                            <div style="font-size: 0.75rem; color: var(--text-3);">Report incidents</div>
                        </div>
                    </div>
                    <div style="flex: 1; cursor: pointer;" @onclick="() => SelectRole(UserRole.Authority)">
                        <div style="padding: 16px; text-align: center; border-radius: var(--radius-md); border: 1px solid var(--glass-border); transition: all 200ms ease; @GetRoleCardStyle(UserRole.Authority)">
                            <div style="font-size: 1.5rem; margin-bottom: 8px;">🚔</div>
                            <div style="font-weight: 600; font-size: 0.9rem;">Authority</div>
                            <div style="font-size: 0.75rem; color: var(--text-3);">Police/Rescue</div>
                        </div>
                    </div>
                </div>
            </div>

            <div>
                <label class="login-label">Password</label>
                <InputText type="password" class="login-input" @bind-Value="model.Password" placeholder="••••••••" autocomplete="new-password" />
                <ValidationMessage For="@(() => model.Password)" />
            </div>

            <div>
                <label class="login-label">Confirm Password</label>
                <InputText type="password" class="login-input" @bind-Value="model.ConfirmPassword" placeholder="••••••••" autocomplete="new-password" />
                <ValidationMessage For="@(() => model.ConfirmPassword)" />
            </div>

            @if (!string.IsNullOrEmpty(Error))
            {
                <div class="login-alert login-alert-error">
                    &#9888; @Error
                </div>
            }

            @if (!string.IsNullOrEmpty(Success))
            {
                <div class="login-alert login-alert-info">
                    &#8505; @Success
                </div>
            }

            <button type="submit" class="login-btn" disabled="@IsLoading">
                @if (IsLoading)
                {
                    <span>PROCESSING...</span>
                }
                else
                {
                    <span>INITIALIZE ACCOUNT</span>
                }
            </button>
        </EditForm>

        <div style="text-align: center; margin-top: 24px;">
            <a href="/login" style="font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-3); text-decoration: none; text-transform: uppercase; letter-spacing: 0.1em;">
                ← Access Terminal
            </a>
        </div>
    </div>

    <p style="text-align: center; margin-top: 24px; font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-3); text-transform: uppercase; letter-spacing: 0.1em;">
        SafeZone v1.0 • CS-284L • Air University
    </p>
</div>

@code {
    private RegisterDto model = new() { Role = UserRole.Resident };
    private string? Error { get; set; }
    private string? Success { get; set; }
    private bool IsLoading { get; set; }

    protected override void OnInitialized()
    {
        var uri = Navigation.Uri;
        var idx = uri.IndexOf('?');
        if (idx >= 0 && uri.Length > idx + 1)
        {
            var query = uri[(idx + 1)..];
            foreach (var part in query.Split('&'))
            {
                var eq = part.IndexOf('=');
                if (eq > 0 && part[..eq] == "error" && eq + 1 < part.Length)
                {
                    Error = Uri.UnescapeDataString(part[(eq + 1)..]);
                    break;
                }
            }
        }
    }

    private string GetRoleCardStyle(UserRole role)
    {
        return model.Role == role ? "border-color: var(--primary); background: var(--primary-dim);" : "";
    }

    private void SelectRole(UserRole role)
    {
        model.Role = role;
    }

    private async Task HandleRegister()
    {
        Error = null;
        Success = null;
        IsLoading = true;

        try
        {
            var result = await AuthService.RegisterAsync(model);

            if (result.Success)
            {
                Success = result.Message ?? "Account created successfully.";
                ToastSvc.ShowSuccess(Success);
                await Task.Delay(500);
                Navigation.NavigateTo("/login", forceLoad: false);
            }
            else
            {
                Error = result.Message ?? "Registration failed.";
            }
        }
        catch (HttpRequestException ex)
        {
            Logger.LogError(ex, "Network error while registering {Phone}.", model.PhoneNumber);
            Error = "Network error while creating the account. Check the connection and try again.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected registration error for {Phone}.", model.PhoneNumber);
            Error = "An unexpected error occurred while creating the account. Please try again.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void HandleInvalidSubmit()
    {
        Success = null;
        Error = "Please fix the highlighted fields and try again.";
    }
}
